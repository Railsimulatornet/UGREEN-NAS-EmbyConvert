# EmbyConvert - SMTP / Wochenreport Konfiguration
#
# Diese Datei liegt im gleichen Ordner wie docker-compose.yaml.
# Trage hier deine SMTP-Zugangsdaten ein.
#
# Hinweise:
# - SMTP_TO kann mehrere Empfänger enthalten (Komma oder Semikolon getrennt)
# - Wenn dein Provider STARTTLS nutzt: SMTP_TLS=1 (typisch Port 587)
# - Wenn dein Provider SMTPS/SSL nutzt: SMTP_SSL=1 (typisch Port 465)
# - Zum Testen ohne Mailversand: REPORT_DRY_RUN=1 (HTML wird trotzdem geschrieben)

# --- SMTP Server ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_SSL=0

# --- Login (optional, falls Server Auth erfordert) ---
SMTP_USER=
SMTP_PASS=

# --- Absender / Empfänger ---
SMTP_FROM=
SMTP_TO=

# --- Report Einstellungen ---
REPORT_HOSTNAME=UgreenNAS
REPORT_TZ=Europe/Berlin
REPORT_DAYS=7
REPORT_MAX_ITEMS=200
REPORT_DRY_RUN=0

# --- Optional: Betreff-Prefix ---
REPORT_SUBJECT_PREFIX=[EmbyConvert]

# EmbyConvert - SMTP / Weekly report configuration
#
# This file is located in the same folder as docker-compose.yaml.
# Enter your SMTP credentials here.
#
# Notes:
# - SMTP_TO can contain multiple recipients (comma or semicolon separated)
# - If your provider uses STARTTLS: SMTP_TLS=1 (typically port 587)
# - If your provider uses SMTPS/SSL: SMTP_SSL=1 (typically port 465)
# - To test without sending an email: REPORT_DRY_RUN=1 (HTML will still be written)

# --- SMTP server ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_SSL=0

# --- Login (optional, if the server requires authentication) ---
SMTP_USER=
SMTP_PASS=

# --- Sender / recipients ---
SMTP_FROM=
SMTP_TO=

# --- Report settings ---
REPORT_HOSTNAME=UgreenNAS
REPORT_TZ=Europe/Berlin
REPORT_DAYS=7
REPORT_MAX_ITEMS=200
REPORT_DRY_RUN=0

# --- Optional: subject prefix ---
REPORT_SUBJECT_PREFIX=[EmbyConvert]
